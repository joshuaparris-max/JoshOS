[Unit]
Description=Josh OS local network control service
After=NetworkManager.service systemd-resolved.service
Wants=NetworkManager.service systemd-resolved.service
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/local/lib/josh-os/network-control.py
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-write
ReadWritePaths=/home/josh
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
